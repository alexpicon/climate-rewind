# Copy to .env.local (git-ignored) and fill in. Never commit real values, never expose them to the browser.
ANTHROPIC_API_KEY=
# Hard cap on input plus output tokens the AI briefing and "Ask your street" may use per UTC day (per server instance).
# Missing or not a whole number: 3000000 (about 750 briefs). 0 switches the AI off ("AI is resting").
# This is only a per-instance ceiling. The real safety net is the monthly spend cap you set in the Anthropic console.
AI_DAILY_TOKEN_BUDGET=3000000
